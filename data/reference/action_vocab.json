 "engines": [
  {
   "engine": "bitrix",
   "kind": "cart",
   "path": "sale\\.basket\\.basket|sale\\.basket\\.basket\\.line",
   "method": "POST",
   "role": "cart_handler",
   "to_verify": "обработчики корзины Битрикса: это обработчики страницы корзины, не действия с товаром"
  },
  {
   "engine": "woocommerce",
   "kind": "cart",
   "query": "(?:^|&)add-to-cart=\\d+|(?:^|&)wc-ajax=add_to_cart(?:&|$)|(?:^|&)action=woocommerce_add_to_cart",
   "method": "any",
   "role": "action"
  },
  {
   "engine": "woocommerce",
   "kind": "cart_service",
   "query": "(?:^|&)wc-ajax=(?:remove_from_cart|get_refreshed_fragments|get_cart_totals|apply_coupon|remove_coupon|update_shipping_method|update_order_review|checkout)(?:&|$)|(?:^|&)action=woocommerce_",
   "method": "any",
   "role": "cart_handler",
   "to_verify": "служебные вызовы WooCommerce: обновление корзины и оформления, не действия с товаром"
  },
  {
   "engine": "opencart",
   "kind": "cart",
   "query": "(?:^|&)route=checkout/cart/add",
   "method": "POST",
   "role": "action",
   "to_verify": "OpenCart: добавление в корзину"
  },
  {
   "engine": "opencart",
   "kind": "cart_service",
   "query": "(?:^|&)route=checkout/cart/(?:edit|remove)",
   "method": "POST",
   "role": "cart_handler",
   "to_verify": "OpenCart: изменение и удаление в корзине"
  },
  {
   "engine": "prestashop",
   "kind": "cart",
   "query": "(?:^|&)add=1(?:&|$)",
   "path": "(?:^|/)(?:cart|panier)",
   "method": "POST",
   "role": "action",
   "to_verify": "PrestaShop: controller=cart с add; update, delete, op=up|down — обработчики корзины"
  },
  {
   "engine": "shopify",
   "kind": "cart",
   "path": "^/cart/add(?:\\.js)?$",
   "method": "POST",
   "role": "action",
   "to_verify": "Shopify: добавление в корзину"
  },
  {
   "engine": "shopify",
   "kind": "cart_service",
   "path": "^/cart/(?:change|update|clear)(?:\\.js)?$|^/cart\\.js$",
   "method": "any",
   "role": "cart_handler",
   "to_verify": "Shopify: изменение корзины"
  },
  {
   "engine": "magento",
   "kind": "cart",
   "path": "^/checkout/cart/add(?:/|$)",
   "method": "POST",
   "role": "action",
   "to_verify": "Magento: добавление в корзину"
  },
  {
   "engine": "magento",
   "kind": "cart_service",
   "path": "^/checkout/cart/(?:updatePost|delete)(?:/|$)",
   "method": "POST",
   "role": "cart_handler",
   "to_verify": "Magento: изменение корзины"
  },
  {
   "engine": "joomla",
   "kind": "cart",
