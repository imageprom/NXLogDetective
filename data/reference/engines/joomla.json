    },
    {
      "путь": "/components/",
      "роль": "система",
      "что": "компоненты"
    },
    {
      "путь": "/modules/",
      "роль": "система",
      "что": "модули"
    },
    {
      "путь": "/plugins/",
      "роль": "система",
      "что": "плагины"
    },
    {
      "путь": "/templates/",
