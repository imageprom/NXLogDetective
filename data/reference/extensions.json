    },
    {
      "группа": "Фиды и выгрузки",
      "шаблон": "(/export/|/feeds?(/|\\.xml$|$)|/rss(/|\\.xml$|$)|yandex[\\w-]*\\.xml$|google[\\w-]*\\.xml$)"
